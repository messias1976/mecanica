# Copie para .env.local e preencha com os dados do seu projeto Supabase.
# Preferencial: chave Publishable (sb_publishable_...). Nunca use secret/service_role no frontend.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_SUA_CHAVE_PUBLICA
# Compatibilidade com projetos antigos (opcional; use só se não tiver publishable key):
# VITE_SUPABASE_ANON_KEY=SUA_CHAVE_ANON_LEGADA
